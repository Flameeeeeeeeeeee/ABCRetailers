@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mt-4">
    <h2>Welcome, @User.Identity?.Name!</h2>
    <p class="text-muted">You are logged in as an <strong>Administrator</strong>.</p>

    <div class="list-group mt-4">

        <a asp-controller="Customer" asp-action="Index" class="list-group-item list-group-item-action list-group-item-primary d-flex justify-content-between align-items-center">
            <span><i class="fas fa-users me-2"></i> Manage Customers</span>
            <i class="fas fa-arrow-right"></i>
        </a>

        <a asp-controller="Product" asp-action="Index" class="list-group-item list-group-item-action list-group-item-success d-flex justify-content-between align-items-center">
            <span><i class="fas fa-box me-2"></i> Manage Products</span>
            <i class="fas fa-arrow-right"></i>
        </a>

        <a asp-controller="Order" asp-action="Index" class="list-group-item list-group-item-action list-group-item-warning d-flex justify-content-between align-items-center">
            <span><i class="fas fa-clipboard-list me-2"></i> View & Process Orders</span>
            <i class="fas fa-arrow-right"></i>
        </a>

        <a asp-controller="Upload" asp-action="Index" class="list-group-item list-group-item-action list-group-item-info d-flex justify-content-between align-items-center">
            <span><i class="fas fa-upload me-2"></i> View Uploaded Files</span>
            <i class="fas fa-arrow-right"></i>
        </a>

        <a asp-controller="Home" asp-action="Privacy" class="list-group-item list-group-item-action list-group-item-danger d-flex justify-content-between align-items-center">
            <span><i class="fas fa-shield-alt me-2"></i> Manage Privacy Policy</span>
            <i class="fas fa-arrow-right"></i>
        </a>

    </div>
</div>